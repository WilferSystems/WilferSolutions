---
import { Image } from 'astro:assets';
import logoSymbol from '../assets/brand-symbol.png';
import logoLight from '../assets/logo-light.png';
import logoDark from '../assets/logo-dark.png';
const { compact = false, lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';
const label = isEnglish ? 'Wilfer Solutions — Technology that solves' : 'Wilfer Solutions — Tecnología que resuelve';
---
<a class="brand" href={`/${lang}/`} aria-label={isEnglish ? 'Wilfer Solutions, home' : 'Wilfer Solutions, inicio'}>
  {compact ? (
    <Image class="brand-symbol" src={logoSymbol} width={64} height={64} alt="" format="webp" />
  ) : (
    <>
      <Image class="brand-logo brand-logo-light" src={logoLight} alt={label} format="webp" quality={90} loading="eager" />
      <Image class="brand-logo brand-logo-dark" src={logoDark} alt={label} format="webp" quality={90} loading="eager" />
    </>
  )}
</a>
