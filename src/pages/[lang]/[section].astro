---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageCopy, type Lang, whatsappNumber, whatsappUrl } from '../../lib/content';
export function getStaticPaths(){
 const pages={es:['servicios','empresas','particulares','sobre-mi','proyectos','preguntas-frecuentes','contacto','privacidad','blog'],en:['services','businesses','individuals','about','projects','faq','contact','privacy','blog']};
 return Object.entries(pages).flatMap(([lang,sections])=>sections.map(section=>({params:{lang,section}})));
}
const lang=Astro.params.lang as Lang; const section=Astro.params.section!; const isEs=lang==='es'; const c=pageCopy[lang];
const lookup:any={es:{servicios:['services','Servicios'],empresas:['businesses','Empresas'],particulares:['individuals','Particulares'],'sobre-mi':['about','Sobre mí'],proyectos:['projects','Proyectos'],'preguntas-frecuentes':['faq','Preguntas frecuentes'],contacto:['contact','Contacto'],privacidad:['privacy','Política de privacidad'],blog:['blog','Blog']},en:{services:['services','Services'],businesses:['businesses','Businesses'],individuals:['individuals','Individuals'],about:['about','About'],projects:['projects','Projects'],faq:['faq','FAQ'],contact:['contact','Contact'],privacy:['privacy','Privacy policy'],blog:['blog','Blog']}};
const kind=lookup[lang][section][0]; const heading=lookup[lang][section][1];
const desc=isEs?`${heading} de Wilfer Solutions. Atención personal, comunicación clara y presupuesto antes de comenzar.`:`${heading} from Wilfer Solutions. Personal attention, clear communication and a quote before work begins.`;
const path=`/${lang}/${section}/`;
const counterparts:any={servicios:'services',services:'servicios',empresas:'businesses',businesses:'empresas',particulares:'individuals',individuals:'particulares','sobre-mi':'about',about:'sobre-mi',proyectos:'projects',projects:'proyectos','preguntas-frecuentes':'faq',faq:'preguntas-frecuentes',contacto:'contact',contact:'contacto',privacidad:'privacy',privacy:'privacidad',blog:'blog'}; const alternatePath=`/${isEs?'en':'es'}/${counterparts[section]}/`;
---
<BaseLayout lang={lang} title={`${heading} | Wilfer Solutions`} description={desc} path={path} alternatePath={alternatePath}>
{kind==='services'&&<><header class="page-hero"><span class="eyebrow">01 / {isEs?'SERVICIOS':'SERVICES'}</span><h1>{c.services.title}</h1><p>{c.services.intro}</p></header><section class="section section-soft"><div class="section-inner detail-list">{c.services.sections.map(([id,title,body,forWhom,href],i)=><article class="detail-row" id={id}><span class="detail-index">0{i+1} /</span><div><h2>{title}</h2><p>{body}</p><p class="for">{isEs?'Dirigido a':'For'}: {forWhom}</p><a class="text-link" href={href}>{isEs?'Consultar sobre este servicio':'Ask about this service'} <span>↗</span></a></div></article>)}</div></section><section class="section"><div class="section-inner"><h2 class="section-heading">{isEs?'Una propuesta a la medida de tu necesidad':'A proposal shaped around your needs'}</h2><p class="section-lead">{isEs?'No hay paquetes ni precios publicados. Después de conversar y evaluar el alcance, recibís un presupuesto personalizado. El trabajo comienza cuando lo aprobás.':'There are no published packages or prices. After discussing your needs and scope, you receive a tailored quote. Work begins once you approve it.'}</p><a class="button button-primary" href={`/${lang}/${isEs?'contacto':'contact'}/`}>{isEs?'Solicitar una consulta':'Request a conversation'} ↗</a></div></section></>}
{kind==='businesses'&&<><header class="page-hero"><span class="eyebrow">02 / {isEs?'EMPRESAS Y EMPRENDIMIENTOS':'BUSINESSES AND VENTURES'}</span><h1>{c.businesses.title}</h1><p>{c.businesses.intro}</p></header><section class="section section-soft"><div class="section-inner"><ul class="bullets">{c.businesses.points.map(p=><li>{p}</li>)}</ul><a class="button button-primary" href={`/${lang}/${isEs?'contacto':'contact'}/`}>{c.businesses.cta} ↗</a></div></section><section class="section"><div class="section-inner statement"><h2>{isEs?'Una conversación clara antes de cualquier decisión.':'A clear conversation before any decision.'}</h2><p>{isEs?'La tecnología disponible y las necesidades del negocio varían. La orientación se adapta a tu contexto; las opciones, el alcance, los costos y los tiempos se conversan antes de avanzar.':'Available technology and business needs vary. Guidance is tailored to your context; options, scope, costs and timing are discussed before moving forward.'}</p></div></section></>}
{kind==='individuals'&&<><header class="page-hero"><span class="eyebrow">02 / {isEs?'PARTICULARES Y PROFESIONALES':'INDIVIDUALS AND PROFESSIONALS'}</span><h1>{c.individuals.title}</h1><p>{c.individuals.intro}</p></header><section class="section section-soft"><div class="section-inner"><ul class="bullets">{c.individuals.points.map(p=><li>{p}</li>)}</ul><a class="button button-primary" target="_blank" rel="noreferrer" href={whatsappUrl}>{c.individuals.cta} ↗</a></div></section></>}
{kind==='about'&&<><header class="page-hero"><span class="eyebrow">03 / {isEs?'SOBRE MÍ':'ABOUT ME'}</span><h1>{c.about.title}</h1></header><section class="section section-soft"><div class="section-inner profile-grid"><div class="profile-portrait"><img class="brand-logo brand-logo-dark" src="/logo-dark.png" width="1000" height="273" alt={isEs ? 'Logotipo Wilfer Solutions' : 'Wilfer Solutions logo'} /></div><div class="profile-content"><p>{c.about.intro}</p><p>{c.about.body}</p><p class="profile-quote">“{c.about.quote}”</p><div class="profile-facts"><div class="fact"><h3>{c.about.education}</h3><p>{c.about.educationValue}</p></div><div class="fact"><h3>{c.about.languages}</h3><p>{c.about.languageValue}</p></div><div class="fact" style="grid-column:1/-1"><h3>{c.about.skills}</h3><p>{c.about.skillsValue}</p></div></div><div class="button-row"><a class="button button-outline" href="https://www.linkedin.com/in/wilfer-reyel-84a4a9267" target="_blank" rel="noreferrer">LinkedIn ↗</a><a class="button button-outline" href="https://github.com/WilferSystems" target="_blank" rel="noreferrer">GitHub ↗</a></div></div></div></section></>}
{kind==='projects'&&<><header class="page-hero"><span class="eyebrow">04 / {isEs?'DESARROLLO Y APRENDIZAJE':'DEVELOPMENT AND LEARNING'}</span><h1>{c.projects.title}</h1><p>{c.projects.intro}</p></header><section class="section section-soft"><div class="section-inner project-list">{c.projects.items.map(([title,body,tech,repo])=><article class="project-card"><h2>{title}</h2><p>{body}</p><span class="tech">{tech}</span>{repo&&<a class="text-link" href={repo} target="_blank" rel="noreferrer">{isEs?'Ver repositorio':'View repository'} <span>↗</span></a>}</article>)}</div></section></>}
{kind==='faq'&&<><header class="page-hero"><span class="eyebrow">05 / FAQ</span><h1>{c.faq.title}</h1></header><section class="section section-soft"><div class="section-inner faq-list">{c.faq.items.map(([question,answer])=><details class="faq-item"><summary>{question}</summary><p>{answer}</p></details>)}</div></section></>}
{kind==='contact'&&<><header class="page-hero"><span class="eyebrow">06 / {isEs?'CONTACTO':'CONTACT'}</span><h1>{c.contact.title}</h1><p>{c.contact.intro}</p></header><section class="section section-soft"><div class="section-inner contact-layout"><aside class="contact-aside"><h2>{isEs?'Canales directos':'Direct contact'}</h2><div class="contact-channel"><small>WhatsApp</small><a href={whatsappUrl} target="_blank" rel="noreferrer">{whatsappNumber} ↗</a></div><div class="contact-channel"><small>{isEs?'Correo electrónico':'Email'}</small><a href="mailto:wilfercabrera15@gmail.com">wilfercabrera15@gmail.com</a></div><p style="color:var(--muted);font-size:13px">{isEs?'La atención es principalmente remota. Una reunión por videollamada o una visita presencial excepcional se coordina si resulta viable.':'Service is mainly remote. Video calls or an exceptional in-person visit can be arranged when feasible.'}</p></aside><div><h2>{c.contact.formTitle}</h2><form class="contact-form" id="contact-form" action="/api/contact" method="post" novalidate><div class="field"><label for="name">{c.contact.name} *</label><input id="name" name="name" required maxlength="100" autocomplete="name"/></div><div class="field"><label for="email">{c.contact.email} *</label><input id="email" name="email" type="email" required maxlength="254" autocomplete="email"/></div><div class="field"><label for="type">{c.contact.type} *</label><select id="type" name="type" required><option value="">{c.contact.select}</option>{c.contact.options.map((o,i)=><option value={['support','advice','web','general'][i]}>{o}</option>)}</select></div><div class="field"><label for="subject">{c.contact.subject} *</label><input id="subject" name="subject" required maxlength="160"/></div><div class="field full"><label for="message">{c.contact.description} *</label><textarea id="message" name="message" required maxlength="4000"></textarea></div><div class="honeypot" aria-hidden="true"><label for="website">{isEs?'Dejá este campo vacío':'Leave this field empty'}</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div><p class="form-note">{c.contact.privacy} <a class="text-link" href={`/${lang}/${isEs?'privacidad':'privacy'}/`}>{isEs?'Leer política':'Read policy'} <span>↗</span></a></p><div class="form-status" role="status" aria-live="polite"></div><button class="button button-primary" type="submit">{c.contact.send} <span class="arrow">↗</span></button></form></div></div></section><script define:vars={{isEs, strings:{required:c.contact.required,invalidEmail:c.contact.invalidEmail,sending:c.contact.sending,success:c.contact.success,error:c.contact.error}}}>
 const form=document.querySelector<HTMLFormElement>('#contact-form'); const status=form?.querySelector<HTMLElement>('.form-status');
 form?.addEventListener('submit',async(e)=>{e.preventDefault();if(!form||!status)return; status.className='form-status';
 const required=[...form.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('[required]')];let bad=false;for(const field of required){field.setCustomValidity('');if(!field.value.trim()){field.setCustomValidity(strings.required);bad=true;}else if(field.type==='email'&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value)){field.setCustomValidity(strings.invalidEmail);bad=true;}}
 if(bad){form.reportValidity();return;}const button=form.querySelector('button[type=submit]');if(!button)return;button.disabled=true;button.textContent=strings.sending;status.textContent='';
 try{const res=await fetch('/api/contact',{method:'POST',body:new FormData(form),headers:{'Accept':'application/json'}});const data=await res.json();if(!res.ok)throw new Error(data.error||'send');status.classList.add('success');status.textContent=strings.success;form.reset();}catch{status.classList.add('error');status.textContent=strings.error;}finally{button.disabled=false;button.innerHTML=`${isEs?'Enviar consulta':'Send inquiry'} <span class="arrow">↗</span>`;}
 });
</script></>}
{kind==='privacy'&&<><header class="page-hero"><span class="eyebrow">07 / {isEs?'PRIVACIDAD':'PRIVACY'}</span><h1>{c.privacy.title}</h1><p>{c.privacy.intro}</p></header><section class="section section-soft"><div class="section-inner privacy-copy"><p>{c.privacy.body}</p><p><a class="text-link" href="mailto:wilfercabrera15@gmail.com">wilfercabrera15@gmail.com <span>↗</span></a></p></div></section></>}
{kind==='blog'&&<><header class="page-hero"><span class="eyebrow">08 / BLOG</span><h1>{isEs?'Notas para una tecnología más simple':'Notes for simpler technology'}</h1><p>{isEs?'Guías originales y recomendaciones prácticas para personas, profesionales y negocios.':'Original guides and practical recommendations for people, professionals and businesses.'}</p></header><section class="section section-soft"><div class="section-inner"><article class="article-preview"><span class="meta">{isEs?'SEGURIDAD DIGITAL':'DIGITAL SECURITY'} · 6 {isEs?'MIN DE LECTURA':'MIN READ'}</span><h3>{isEs?'Tu seguridad digital importa: protegé tus cuentas':'Your digital security matters: protect your accounts'}</h3><p>{isEs?'Medidas sencillas para cuidar tus cuentas personales y profesionales.':'Simple steps to help protect your personal and work accounts.'}</p><a class="text-link" href={`/${lang}/blog/${isEs?'seguridad-cuentas':'account-security'}/`}>{isEs?'Leer artículo':'Read article'} <span>↗</span></a></article></div></section></>}
</BaseLayout>
