---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { home, siteUrl, whatsappUrl } from '../../lib/content';
export function getStaticPaths(){return [{params:{lang:'es'}},{params:{lang:'en'}}]}
const lang = Astro.params.lang as 'es'|'en'; const c = home[lang]; const isEs=lang==='es';
const title = isEs ? 'Wilfer Solutions | Soporte técnico y soluciones tecnológicas' : 'Wilfer Solutions | IT support and technology solutions';
const description = isEs ? 'Soporte técnico informático, asesoramiento tecnológico y desarrollo web para particulares y empresas. Atención personal y presupuesto antes de empezar.' : 'IT support, technology advice and web development for individuals and businesses. Personal service and a quote before work begins.';
---
<BaseLayout lang={lang} title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org','@type':'Person',name:'Wilfer Florentin',url:siteUrl?`${siteUrl}/${lang}/`:undefined,jobTitle:isEs?'Servicios y soluciones tecnológicas':'Technology services and solutions',sameAs:['https://www.linkedin.com/in/wilfer-reyel-84a4a9267','https://github.com/WilferSystems']})}/>
  <section class="hero"><div><div class="eyebrow">{c.eyebrow}</div><h1>{c.title}<br/><em>{c.accent}</em></h1><p class="hero-copy">{c.intro}</p><div class="button-row"><a class="button button-primary" href={`/${lang}/${isEs?'contacto':'contact'}/`}>{c.primary}<span class="arrow">↗</span></a><a class="button button-outline" href={`/${lang}/${isEs?'servicios':'services'}/`}>{c.secondary}</a></div><p class="hero-note">{c.proof}</p></div>
  <div class="hero-art"><img class="hero-art-logo brand-logo-light" src="/logo-light.png" width="1000" height="273" alt={isEs ? 'Logotipo Wilfer Solutions en azul y celeste' : 'Wilfer Solutions logo in navy and blue'} /><img class="hero-art-logo brand-logo-dark" src="/logo-dark.png" width="1000" height="273" alt={isEs ? 'Logotipo Wilfer Solutions en blanco y celeste' : 'Wilfer Solutions logo in white and blue'} /></div></section>
  <section class="section section-soft"><div class="section-inner statement"><h2>{c.statement}</h2><p>{c.statementBody}</p></div></section>
  <section class="section"><div class="section-inner"><span class="section-kicker">01 / {isEs?'Servicios':'Services'}</span><h2 class="section-heading">{c.servicesTitle}</h2><p class="section-lead">{c.servicesLead}</p><div class="service-grid">{c.services.map(([n,title,desc,audience,href])=><article class="service-item"><span class="service-number">{n} /</span><h3>{title}</h3><p>{desc}</p><span class="audience">{audience}</span><br/><a class="text-link" href={href}>{isEs?'Conocer más':'Learn more'} <span>↗</span></a></article>)}</div></div></section>
  <section class="section section-soft"><div class="section-inner"><span class="section-kicker">02 / {isEs?'A quién acompaño':'Who I help'}</span><h2 class="section-heading">{c.audienceTitle}</h2><div class="audience-grid">{c.audience.map(([title,body,label,href])=><a class="audience-card" href={href}><span class="small-label">{label}</span><h3>{title}</h3><p>{body}</p><span class="text-link">{isEs?'Ver cómo puedo ayudarte':'See how I can help'} <span>↗</span></span></a>)}</div></div></section>
  <section class="section"><div class="section-inner"><span class="section-kicker">03 / {isEs?'Cómo trabajamos':'How it works'}</span><h2 class="section-heading">{c.processTitle}</h2><p class="section-lead">{c.processLead}</p><div class="process">{c.steps.map(step=><div class="process-step">{step}</div>)}</div></div></section>
  <section class="section section-soft"><div class="section-inner project-strip"><div><span class="section-kicker">04 / {isEs?'Proyectos':'Projects'}</span><h2 class="section-heading">{c.projectsTitle}</h2><p class="section-lead">{c.projectsLead}</p><a class="text-link" href={`/${lang}/${isEs?'proyectos':'projects'}/`}>{isEs?'Explorar proyectos':'Explore projects'} <span>↗</span></a></div><div class="project-preview"><div class="project-chip">SmartTranscript <small>Python · Whisper</small></div><div class="project-chip">Evento <small>Flutter · Supabase</small></div><div class="project-chip">SGAI <small>REST · PostgreSQL</small></div><div class="project-chip">{isEs?'Aprendizaje continuo':'Continuous learning'} <small>UTN · Systems</small></div></div></div></section>
  <section class="section"><div class="section-inner blog-strip"><div><span class="section-kicker">05 / Blog</span><h2 class="section-heading">{c.blogTitle}</h2><p class="section-lead">{c.blogLead}</p><a class="text-link" href={`/${lang}/blog/`}>{isEs?'Ir al blog':'Visit the blog'} <span>↗</span></a></div><article class="article-preview"><span class="meta">{isEs?'Seguridad digital · 6 min':'Digital security · 6 min'}</span><h3>{isEs?'Tu seguridad digital importa: protegé tus cuentas':'Your digital security matters: protect your accounts'}</h3><p>{isEs?'Medidas sencillas para cuidar tus cuentas personales y profesionales.':'Simple steps to help protect your personal and work accounts.'}</p></article></div></section>
  <section class="contact-band"><div class="contact-band-inner"><div><h2>{c.contactTitle}</h2><p>{c.contactLead}</p></div><div class="button-row"><a class="button button-primary" href={whatsappUrl} target="_blank" rel="noreferrer">{c.cta}<span class="arrow">↗</span></a><a class="button button-outline" href="mailto:wilfercabrera15@gmail.com">{c.email}</a></div></div></section>
</BaseLayout>
